{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "iter5 pooled inputs (panel A/B)",
 "type": "object",
 "required": [
  "schema_version",
  "panel",
  "generated_utc",
  "records"
 ],
 "properties": {
  "schema_version": {
   "const": "iter5_panel_v1"
  },
  "panel": {
   "enum": [
    "A",
    "B"
   ]
  },
  "generated_utc": {
   "type": "string"
  },
  "records": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "schema_version",
     "panel",
     "unit_id",
     "unit_kind",
     "parent_id",
     "cluster_id",
     "source_ids",
     "unit_facts",
     "twin",
     "base",
     "rivals",
     "forecasts",
     "commit",
     "outcomes",
     "audit_engine"
    ],
    "properties": {
     "schema_version": {
      "const": "iter5_panel_v1"
     },
     "panel": {
      "enum": [
       "A",
       "B"
      ]
     },
     "unit_id": {
      "type": "string"
     },
     "unit_kind": {
      "enum": [
       "new_task",
       "disguised_variant",
       "parent_remeasure"
      ]
     },
     "parent_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "cluster_id": {
      "type": "string"
     },
     "source_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "unit_facts": {
      "type": "object",
      "required": [
       "K_u",
       "excluded_by_limit",
       "catalogue_sha256",
       "default"
      ]
     },
     "twin": {
      "type": "object",
      "required": [
       "correct_composition",
       "attempted_composition",
       "pass"
      ]
     },
     "base": {
      "type": "object",
      "required": [
       "beta_u",
       "beta_attempt",
       "beta_plain",
       "r_u",
       "correct_composition",
       "n_correct_base",
       "hill1",
       "goods_coverage",
       "P_beta_ge_0.05",
       "P_beta_ge_0.2"
      ]
     },
     "rivals": {
      "type": "object",
      "required": [
       "R_margin",
       "R_merit_runtime",
       "R_merit_length",
       "R_modal",
       "R_novel"
      ]
     },
     "forecasts": {
      "type": "object"
     },
     "commit": {
      "type": "object",
      "required": [
       "sha256",
       "utc",
       "chain_index"
      ]
     },
     "outcomes": {
      "type": "object",
      "required": [
       "E_alpha1",
       "E_alpha2",
       "E_u",
       "per_direction",
       "push_landing_composition",
       "pn_cells",
       "t13_cell"
      ]
     },
     "audit_engine": {
      "type": "object",
      "required": [
       "engine",
       "precision",
       "unit_scale"
      ]
     }
    }
   }
  }
 }
}