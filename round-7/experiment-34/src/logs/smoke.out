def solve(n, edges):
    parent = list(range(n))
    
    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]
    
    def union(x, y):
        rootX = find(x)
        rootY = find(y)
        if rootX != rootY:
            parent[rootY] = rootX
    
    for u, v in edges:
        union(u, v)
    
    roots = set()
    for i in range(n):
        roots.add(find(i))
    
    return len(roots)
