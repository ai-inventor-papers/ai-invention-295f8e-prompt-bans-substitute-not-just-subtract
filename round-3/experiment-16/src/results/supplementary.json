    "code": "def solve(intervals):\n    if not intervals:\n        return []\n    \n    # Create a list to hold the merged intervals\n    merged = []\n    \n    # Find the interval with the minimum start time\n    min_start = min(interval[0] for interval in intervals)\n    # Find the interval with the maximum end time\n    max_end = max(interval[1] for interval in intervals)\n    \n    # Initialize the current merged interval\n    current_start = min_start\n    current_end = 0\n    \n    # Iterate through all intervals to find overlaps\n    for interval in intervals:\n        if interval[0] <= current_end:\n            # Overlapping or touching, merge them\n            current_end = max(current_end, interval[1])\n        else:\n            # No overlap, add the current merged interval\n            merged.append([current_start, current_end])\n            current_start = interval[0]\n            current_end = interval[1]\n    \n    # Add the last merged interval\n    merged.append([current_start, current_end])\n    \n    # Sort the merged intervals by start time\n    merged.sort()\n    return merged\n"
