    "code": "def solve(intervals):\n    if not intervals:\n        return []\n    \n    # Create a list of start and end points\n    start_points = []\n    end_points = []\n    \n    for interval in intervals:\n        start_points.append(interval[0])\n        end_points.append(interval[1])\n    \n    # Find the minimum start and maximum end to determine the range\n    min_start = min(start_points)\n    max_end = max(end_points)\n    \n    # Initialize merged intervals\n    merged = []\n    current_start = min_start\n    current_end = min_start - 1\n    \n    # Iterate through all possible points from min_start to max_end\n    for point in range(min_start, max_end + 1):\n        # Check if the current point is the start of an interval\n        if point in start_points:\n            if current_end < point:\n                # Start a new merged interval\n                merged.append([current_start, current_end])\n                current_start = point\n            else:\n                # Continue the current merged interval\n                current_end = max(current_end, point)\n        # Check if the current point is the end of an interval\n        if point in end_points:\n            current_end = max(current_end, point)\n    \n    # Add the last merged interval\n    if current_start <= current_end:\n        merged.append([current_start, current_end])\n    \n    return merged\n"
