```python
def solve(nums, k):
    def partition(low, high):
        pivot = nums[high]
        i = low
        for j in range(low, high):
            if nums[j] <= pivot:
                nums[i], nums[j] = nums[j], nums[i]
                i += 1
        nums[i], nums[high] = nums[high], nums[i]
        return i

    def quickselect(low, high, k):
        if low == high:
            return nums[low]
        pivot_index = partition(low, high)
        if k == pivot_index:
            return nums[k]
        elif k < pivot_index:
            return quickselect(low, pivot_index - 1, k)
        else:
            return quickselect(pivot_index + 1, high, k)

    return quickselect(0, len(nums) - 1, k - 1)
```
20:51:13|INFO   |--- sample T03:size_k_heap:W1:r0:p0:s2 (175 tokens, stop):
```python
def solve(nums, k):
    def partition(start, end):
        pivot = nums[end]
        i = start
        for j in range(start, end):
            if nums[j] <= pivot:
                nums[i], nums[j] = nums[j], nums[i]
                i += 1
        nums[i], nums[end] = nums[end], nums[i]
        return i

    def quickselect(start, end, k):
        pivot_index = partition(start, end)
        if pivot_index == k:
            return nums[pivot_index]
        elif pivot_index < k:
            return quickselect(pivot_index + 1, end, k)
        else:
            return quickselect(start, pivot_index - 1, k)

    return quickselect(0, len(nums) - 1, k - 1)
```
