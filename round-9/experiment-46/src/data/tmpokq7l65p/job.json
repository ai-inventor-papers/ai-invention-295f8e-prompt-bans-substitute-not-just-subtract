{"code": "def solve(grid, start, goal):\n    if (\n        not grid or\n        not (0 <= start[0] < len(grid) and 0 <= start[1] < len(grid[0])) or\n        not (0 <= goal[0] < len(grid) and 0 <= goal[1] < len(grid[0])) or\n        grid[start[0]][start[1]] == '#' or\n        grid[goal[0]][goal[1]] == '#'\n    ):\n        return []\n\n    if start == goal:\n        return [start]\n\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n    def is_valid(row, col, visited):\n        return (\n            0 <= row < len(grid) and\n            0 <= col < len(grid[0]) and\n            grid[row][col] == '.' and\n            (row, col) not in visited\n        )\n\n    def dfs(current, depth, visited, path):\n        if depth == 0:\n            return None\n        if current == goal:\n            return path + [current]\n        for dr, dc in directions:\n            nr, nc = current[0] + dr, current[1] + dc\n            if is_valid(nr, nc, visited):\n                next_visited = visited | {(nr, nc)}\n                next_path = path + [current]\n                result = dfs((nr, nc), depth - 1, next_visited, next_path)\n                if result is not None:\n                    return result\n        return None\n\n    for depth in range(1, len(grid) * len(grid[0]) + 1):\n        visited = {start}\n        path = [start]\n        result = dfs(start, depth, visited, [])\n        if result:\n            return result\n    return []\n", "grids": [{"id": "open_0", "kind": "open", "distance_class": "short", "rows": ["..........", ".#........", ".........#", "..........", ".......#.#", "..........", "..#.......", "..........", "##.......#", "#........#"], "start": [5, 5], "goal": [7, 6], "bfs_distance": 3, "h": 10, "w": 10}, {"id": "open_1", "kind": "open", "distance_class": "medium", "rows": ["......#..#.", ".#.......#.", "...........", ".....#.....", "..#.....#..", ".....#.....", "...........", ".......#...", "...#..#....", "..#...###..", "....#......"], "start": [2, 7], "