+def hand_awf(items: list[int], cap: int) -> int:
+    """Hand-coded almost-worst-fit packer (reference for the priority form)."""
+    rem: list[int] = []
+    for s in items:
+        fit = [(r, i) for i, r in enumerate(rem) if r >= s]
+        if not fit:
+            rem.append(cap - s)
+            continue
+        fit.sort(key=lambda t: (-t[0], t[1]))  # descending remaining capacity, stable in index
+        _, bi = fit[1] if len(fit) >= 2 else fit[0]
+        rem[bi] -= s
+    return len(rem)
+
+
+def next_fit(items: list[int], cap: int) -> int:
+    """Next Fit (standalone, stateful): only the most recently opened bin is open."""
+    used, rem = 0, -1
+    for s in items:
+        if rem < s:
+            used += 1
+            rem = cap
+        rem -= s
+    return used
+
