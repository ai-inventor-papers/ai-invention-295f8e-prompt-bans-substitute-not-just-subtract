+        if isinstance(node, ast.Name) and node.id == "random":
+            return True
+        if isinstance(node, ast.ImportFrom) and node.module and "random" in node.module:
+            return True
+        if isinstance(node, ast.alias) and "random" in node.name:
+            return True
+    return False
